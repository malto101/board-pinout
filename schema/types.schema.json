{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:board-pinout:schema:types.schema.json",
  "title": "Board pinout part type library",
  "type": "object",
  "required": ["types"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "default": "1.0" },
    "types": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["group", "pin", "pin_array", "receptacle", "gpio_control"]
          },
          "based_on": { "type": "string" },
          "description": { "type": "string" },
          "rows": { "type": "integer", "minimum": 1 },
          "cols": { "type": "integer", "minimum": 1 },
          "node_scale": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 3,
            "description": "Optional multiplier for the visible node marker; defaults to 1."
          },
          "label_scale": {
            "type": "number",
            "minimum": 0.75,
            "maximum": 2,
            "description": "Optional multiplier for the node label text and box; defaults to 1."
          },
          "numbering": {
            "type": "string",
            "enum": ["row_major", "col_major", "custom"]
          },
          "pin_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "receptacle_type": { "type": "string" },
          "control_type": { "type": "string" },
          "default_children": { "type": "array" },
          "default_electrical": { "type": "object" },
          "default_net": { "type": "object" }
        }
      }
    }
  }
}
